    <link rel="stylesheet" href="style.css">

    <style>
        /* कवी पेजसाठी अतिरिक्त कार्ड Design */

        .poets-section {
            background: var(--cream);
        }

        .poets-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .poet-card {
            background: var(--white);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
            transition: 0.3s ease;
            border-bottom: 4px solid var(--gold);
        }

        .poet-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow);
        }

        .poet-photo {
            height: 310px;
            background: var(--cream-dark);
            overflow: hidden;
        }

        .poet-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s ease;
        }

        .poet-card:hover .poet-photo img {
            transform: scale(1.05);
        }

        .poet-info {
            padding: 25px;
            text-align: center;
        }

        .poet-info h3 {
            color: var(--green);
            font-size: 24px;
            margin-bottom: 5px;
        }

        .poet-role {
            display: block;
            color: var(--maroon);
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .poet-info p {
            color: var(--muted);
            font-size: 15px;
            line-height: 1.7;
        }

        .poet-work {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid var(--cream-dark);
            color: var(--green);
            font-weight: 700;
            font-size: 14px;
        }

        .poet-work span {
            color: var(--maroon);
        }

        .poets-message {
            max-width: 850px;
            margin: 0 auto 45px;
            text-align: center;
            color: var(--muted);
            font-size: 17px;
        }

        .join-poets {
            background: var(--green);
            color: var(--white);
            text-align: center;
        }

        .join-poets h2 {
            color: var(--white);
            font-size: clamp(30px, 4vw, 45px);
            margin-bottom: 15px;
        }

        .join-poets p {
            color: #e4dac9;
            max-width: 700px;
            margin: 0 auto 25px;
        }

        @media (max-width: 900px) {
            .poets-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .poets-grid {
                grid-template-columns: 1fr;
            }

            .poet-photo {
                height: 330px;
            }
        }
    </style>
</head>

